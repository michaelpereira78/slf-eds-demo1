{
  "name": "slf-eds-demo1",
  "private": true,
  "version": "2.0.0",
  "description": "Edge Delivery Services business-user demo: fictional advisor sites with themes, templates, approved content and compliance review",
  "scripts": {
    "lint:js": "eslint .",
    "lint:css": "stylelint \"blocks/**/*.css\" \"styles/*.css\" \"templates/**/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "start": "npx -y @adobe/aem-cli up --html-folder drafts --html-mount / --no-open",
    "build:content": "python3 tools/build-content.py",
    "new-site": "python3 tools/new-site/new-site.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelpereira78/slf-eds-demo1.git"
  },
  "license": "Apache License 2.0",
  "devDependencies": {
    "@babel/eslint-parser": "7.29.13",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0"
  }
}
